<ui:FluentWindow x:Class="FamilySupermarketPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Family Supermarket POS" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Barcode Search Card -->
            <RowDefinition Height="*"/>    <!-- 2. Cart DataGrid -->
            <RowDefinition Height="Auto"/> <!-- 3. Totals & Checkout -->
            <RowDefinition Height="Auto"/> <!-- 4. Hotkeys Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="26" Margin="0,0,10,0" Foreground="#0078D4"/>
                <StackPanel>
                    <TextBlock Text="AHF PROPERTIES T/A FAMILY SUPERMARKET" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Cash Sale Terminal 01" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="TxtCurrentDate" HorizontalAlignment="Right" VerticalAlignment="Center" 
                       FontSize="15" FontWeight="SemiBold" Foreground="#888888"/>
        </Grid>

        <!-- 1. Barcode & Qty Input Card -->
        <ui:Card Grid.Row="1" Margin="0,0,0,15" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtBarcode" Grid.Column="0" 
                            PlaceholderText="Scan Barcode or Code (Try: 1001, 1002, 1003, 1004)..." 
                            FontSize="16" Icon="{ui:SymbolIcon Symbol=BarcodeScanner24}"
                            KeyDown="TxtBarcode_KeyDown"/>

                <ui:TextBox x:Name="TxtQty" Grid.Column="1" Margin="10,0,0,0" 
                            Text="1" TextAlignment="Center" FontSize="16"/>

                <ui:Button Grid.Column="2" Content="F3 - Search Items" Margin="10,0,0,0" 
                           Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnSearch_Click"/>
            </Grid>
        </ui:Card>

        <!-- 2. Scanned Items Table -->
        <ui:DataGrid Grid.Row="2" x:Name="DataGridCart" AutoGenerateColumns="False" 
                     CanUserAddRows="False" SelectionMode="Single" FontSize="14">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="80"/>
                <DataGridTextColumn Header="Price (Excl)" Binding="{Binding PriceExclDisplay}" Width="140"/>
                <DataGridTextColumn Header="Total (Incl)" Binding="{Binding TotalInclDisplay}" Width="140"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- 3. Totals & Checkout Card -->
        <ui:Card Grid.Row="3" Margin="0,15,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSubtotal" Text="Sub Total: R 0.00" FontSize="14" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtVat" Text="VAT (15%): R 0.00" FontSize="14" Foreground="#AAAAAA" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TxtItemsCount" Text="Items: 0" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" Text="R 0.00" FontSize="34" FontWeight="Bold" 
                               Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,25,0"/>
                    <ui:Button Content="F12 - Complete Sale" Appearance="Primary" 
                               FontSize="16" FontWeight="SemiBold" Padding="25,12" 
                               Click="BtnCompleteSale_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 4. Keyboard Hotkeys Bar -->
        <StatusBar Grid.Row="4" Margin="0,10,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="[Enter] Scan/Add  |  [F3] Lookup  |  [Del] Remove Item  |  [F12] Done / Tender" 
                           FontSize="12" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>