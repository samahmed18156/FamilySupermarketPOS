<ui:FluentWindow x:Class="FamilySupermarketPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Family Supermarket POS" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Classic MiPOS Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- 1. Store & Cashier Header -->
            <RowDefinition Height="Auto"/> <!-- 2. Customer / Account Strip -->
            <RowDefinition Height="Auto"/> <!-- 3. Barcode & Qty Entry -->
            <RowDefinition Height="*"/>    <!-- 4. Scanned Items Table -->
            <RowDefinition Height="Auto"/> <!-- 5. Financial Totals & Checkout -->
            <RowDefinition Height="Auto"/> <!-- 6. Keyboard Shortcuts Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Top Menu Bar (Matches MiPOS structure) -->
        <Menu Grid.Row="0" Background="#202020" Foreground="White" FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="Switch User" Click="MenuSwitchUser_Click"/>
                <MenuItem Header="Lock Terminal"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Stock">
                <MenuItem Header="Stock Maintenance" Click="MenuStockMaint_Click"/>
                <MenuItem Header="Department Maintenance"/>
                <MenuItem Header="Stock Adjustments (Debit/Credit)"/>
                <MenuItem Header="Stock Take"/>
                <Separator/>
                <MenuItem Header="Print Barcodes / Labels"/>
                <MenuItem Header="Stock Reports"/>
            </MenuItem>
            <MenuItem Header="_Creditors">
                <MenuItem Header="Creditors Maintenance"/>
                <MenuItem Header="Goods Received Note (GRN)"/>
                <MenuItem Header="Creditors Debit Notes"/>
                <MenuItem Header="Creditor Transactions"/>
                <MenuItem Header="Creditor Reports"/>
            </MenuItem>
            <MenuItem Header="_Debtors">
                <MenuItem Header="Debtors Maintenance"/>
                <MenuItem Header="Invoicing / Cash Sale" IsChecked="True"/>
                <MenuItem Header="Laybye Maintenance"/>
                <MenuItem Header="Quotations"/>
                <MenuItem Header="Debtors Transactions"/>
                <MenuItem Header="Statements &amp; Age Analysis"/>
            </MenuItem>
            <MenuItem Header="_Utility">
                <MenuItem Header="Cash Up Reconciliation"/>
                <MenuItem Header="Day End Process"/>
                <MenuItem Header="Month End Process"/>
                <MenuItem Header="Petty Cash Vouchers"/>
                <Separator/>
                <MenuItem Header="Company Details"/>
                <MenuItem Header="User &amp; Security Maintenance"/>
                <MenuItem Header="Hardware &amp; Printer Settings"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="User Manual"/>
                <MenuItem Header="About Family Supermarket POS"/>
            </MenuItem>
        </Menu>

        <!-- 1. Store Header & Date -->
        <Grid Grid.Row="1" Margin="20,12,20,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="BuildingShop24" FontSize="26" Margin="0,0,10,0" Foreground="#0078D4"/>
                <StackPanel>
                    <TextBlock Text="AHF PROPERTIES T/A FAMILY SUPERMARKET" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCashier" Text="Cashier: ZAMAN MP  |  Station: M1" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="TxtCurrentDate" HorizontalAlignment="Right" VerticalAlignment="Center" 
                       FontSize="15" FontWeight="SemiBold" Foreground="#888888"/>
        </Grid>

        <!-- 2. Account / Customer Info Strip (Matches MiPOS Num: CASH, Name: Cash Sale) -->
        <ui:Card Grid.Row="2" Margin="20,0,20,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Account Num:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="1" x:Name="TxtAccountNum" Text="CASH" FontSize="13" TextAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,8,0"/>
                <ui:TextBox Grid.Column="3" x:Name="TxtAccountName" Text="Cash Sale" FontSize="13"/>

                <TextBlock Grid.Column="4" Text="Credit Limit: R 0.00" VerticalAlignment="Center" Margin="20,0,15,0" Foreground="Gray"/>
                <TextBlock Grid.Column="5" Text="OS Balance: R 0.00" VerticalAlignment="Center" Foreground="Gray"/>
            </Grid>
        </ui:Card>

        <!-- 3. Barcode & Qty Entry Card -->
        <ui:Card Grid.Row="3" Margin="20,0,20,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtBarcode" Grid.Column="0" 
                            PlaceholderText="Scan Barcode or Enter Product Code..." 
                            FontSize="16" Icon="{ui:SymbolIcon Symbol=BarcodeScanner24}"
                            KeyDown="TxtBarcode_KeyDown"/>

                <ui:TextBox x:Name="TxtQty" Grid.Column="1" Margin="10,0,0,0" 
                            Text="1" TextAlignment="Center" FontSize="16"/>

                <ui:Button Grid.Column="2" Content="F3 - Lookup Item" Margin="10,0,0,0" 
                           Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnSearch_Click"/>
            </Grid>
        </ui:Card>

        <!-- 4. Scanned Items Grid -->
        <ui:DataGrid Grid.Row="4" x:Name="DataGridCart" Margin="20,0,20,0"
                     AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" FontSize="14">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="80"/>
                <DataGridTextColumn Header="Price (Excl)" Binding="{Binding PriceExclDisplay}" Width="130"/>
                <DataGridTextColumn Header="Value (Incl)" Binding="{Binding TotalInclDisplay}" Width="140"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- 5. Totals & Checkout -->
        <ui:Card Grid.Row="5" Margin="20,10,20,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSubtotal" Text="Sub Total: R 0.00" FontSize="14" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtVat" Text="VAT (15%): R 0.00" FontSize="14" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtItemsCount" Text="Num Items: 0" FontSize="13" Foreground="Gray" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" Text="R 0.00" FontSize="36" FontWeight="Bold" 
                               Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,25,0"/>
                    <ui:Button Content="F12 - Done (Tender)" Appearance="Primary" 
                               FontSize="16" FontWeight="SemiBold" Padding="25,12" 
                               Click="BtnCompleteSale_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 6. Bottom Shortcuts Bar -->
        <StatusBar Grid.Row="6" Margin="20,8,20,8" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="[Enter] Add Line  |  [F3] Lookup  |  [Del] Remove Line  |  [F12] Done  |  [Esc] Cancel" 
                           FontSize="12" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>