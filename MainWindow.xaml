<ui:FluentWindow x:Class="FamilySupermarketPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Blue_Knight POS - Complete Retail &amp; Supermarket Suite" Height="840" Width="1240"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Window TitleBar (Minimize, Maximize, Close) -->
            <RowDefinition Height="Auto"/> <!-- 1. Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- 2. Store & Cashier Header -->
            <RowDefinition Height="Auto"/> <!-- 3. Customer / Account Strip -->
            <RowDefinition Height="Auto"/> <!-- 4. Barcode & Action Strip -->
            <RowDefinition Height="*"/>    <!-- 5. Scanned Items Table -->
            <RowDefinition Height="Auto"/> <!-- 6. Financial Totals & Checkout -->
            <RowDefinition Height="Auto"/> <!-- 7. Keyboard Shortcuts Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Modern Window TitleBar with Minimize, Maximize, and Close buttons -->
        <ui:TitleBar Grid.Row="0"
                     Title="Blue_Knight POS - Complete Retail &amp; Supermarket Suite"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     CanMaximize="True"
                     Icon="{ui:SymbolIcon Symbol=Shield24}" />

        <!-- 1. Top Menu Bar (Full MiPOS Structure A to Z) -->
        <Menu Grid.Row="1" Background="#1A1A1A" Foreground="White" FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="Switch Cashier (Login)" Click="MenuSwitchUser_Click"/>
                <MenuItem Header="Lock POS Terminal" Click="MenuLock_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Stock">
                <MenuItem Header="Stock Maintenance" Click="MenuStockMaint_Click"/>
                <MenuItem Header="Department Maintenance" Click="MenuDeptMaint_Click"/>
                <MenuItem Header="Stock Adjustments (Debit/Credit)" Click="MenuStockAdj_Click"/>
                <MenuItem Header="Stock Take &amp; Audit Process" Click="MenuStockTake_Click"/>
                <Separator/>
                <MenuItem Header="Print Barcode &amp; Shelf Labels" Click="MenuShelfLabels_Click"/>
                <MenuItem Header="Zero SOH (Zero Stock on Hand) Report" Click="MenuReports_Click"/>
                <MenuItem Header="Stock Valuation Report" Click="MenuReports_Click"/>
            </MenuItem>
            <MenuItem Header="_Creditors">
                <MenuItem Header="Goods Received Note (GRN)" Click="MenuGrn_Click"/>
                <MenuItem Header="Creditors Maintenance (Suppliers)" Click="MenuCreditorMaint_Click"/>
                <MenuItem Header="Supplier Purchase Orders"/>
                <MenuItem Header="Creditor Transactions &amp; Audit"/>
            </MenuItem>
            <MenuItem Header="_Debtors">
                <MenuItem Header="Customer Account Lookup (Ctrl+A)" Click="MenuDebtors_Click"/>
                <MenuItem Header="Debtors Maintenance" Click="MenuDebtorMaint_Click"/>
                <MenuItem Header="Laybye Maintenance" Click="MenuLaybye_Click"/>
                <MenuItem Header="Formal Quotations" Click="MenuQuotes_Click"/>
                <MenuItem Header="Debtors Statements &amp; Age Analysis" Click="MenuAgeAnalysis_Click"/>
            </MenuItem>
            <MenuItem Header="_Utility">
                <MenuItem Header="Cash Up Reconciliation" Click="MenuCashUp_Click"/>
                <MenuItem Header="Petty Cash Vouchers" Click="MenuPettyCash_Click"/>
                <MenuItem Header="Day End Process" Click="MenuDayEnd_Click"/>
                <MenuItem Header="Month End Process" Click="MenuMonthEnd_Click"/>
                <Separator/>
                <MenuItem Header="User &amp; Cashier Maintenance" Click="MenuUserMaint_Click"/>
                <MenuItem Header="Company &amp; Store Details" Click="MenuCompanyDetails_Click"/>
                <MenuItem Header="MySQL Database Configuration" Click="MenuDatabaseConfig_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Quick Reprint Last Slip (F10)" Click="MenuReprint_Click"/>
                <MenuItem Header="About Blue_Knight POS" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Store Header & Cashier Status -->
        <Grid Grid.Row="2" Margin="20,10,20,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Shield24" FontSize="28" Margin="0,0,12,0" Foreground="#0078D4"/>
                <StackPanel>
                    <TextBlock x:Name="TxtStoreTitle" Text="BLUE_KNIGHT SUPERMARKET" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCashier" Text="Cashier: ZAMAN MP  |  Station: M1  |  Mode: Retail POS" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="BadgeReturnMode" Background="#D83B01" CornerRadius="4" Padding="8,4" Margin="0,0,15,0" Visibility="Collapsed">
                    <TextBlock Text="⚠ RETURNS &amp; CREDIT NOTE MODE ACTIVE" FontWeight="Bold" FontSize="12" Foreground="White"/>
                </Border>
                <TextBlock x:Name="TxtCurrentDate" FontSize="15" FontWeight="SemiBold" Foreground="#888888"/>
            </StackPanel>
        </Grid>

        <!-- 3. Customer / Account Strip (Matches MiPOS CASH / Account) -->
        <ui:Card Grid.Row="3" Margin="20,0,20,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Account Num:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="1" x:Name="TxtAccountNum" Text="CASH" FontSize="13" TextAlignment="Center"/>

                <ui:Button Grid.Column="2" Content="Lookup (Ctrl+A)" Margin="6,0,15,0" 
                           Appearance="Secondary" Click="BtnAccountLookup_Click"/>

                <TextBlock Grid.Column="3" Text="Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="4" x:Name="TxtAccountName" Text="Cash Sale" FontSize="13"/>

                <TextBlock Grid.Column="5" x:Name="TxtCreditLimit" Text="Credit Limit: R 0.00" 
                           VerticalAlignment="Center" Margin="20,0,15,0" Foreground="#AAAAAA"/>
                <TextBlock Grid.Column="6" x:Name="TxtOsBal" Text="OS Balance: R 0.00" 
                           VerticalAlignment="Center" Foreground="#AAAAAA"/>
            </Grid>
        </ui:Card>

        <!-- 4. Barcode Entry & Action Toolbar -->
        <ui:Card Grid.Row="4" Margin="20,0,20,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtBarcode" Grid.Column="0" 
                            PlaceholderText="Scan Barcode or Enter Product Code (e.g. 1001, 1002)..." 
                            FontSize="16" Icon="{ui:SymbolIcon Symbol=BarcodeScanner24}"
                            KeyDown="TxtBarcode_KeyDown"/>

                <ui:TextBox x:Name="TxtQty" Grid.Column="1" Margin="8,0,0,0" 
                            Text="1" TextAlignment="Center" FontSize="16"/>

                <ui:Button Grid.Column="2" Content="F3 - Lookup" Margin="8,0,0,0" 
                           Icon="{ui:SymbolIcon Symbol=Search24}" Click="BtnSearch_Click"/>

                <ui:Button Grid.Column="3" Content="F5 - Discount" Margin="6,0,0,0" 
                           Appearance="Secondary" Click="BtnDiscount_Click"/>

                <ui:Button Grid.Column="4" Content="F6 - Price" Margin="6,0,0,0" 
                           Appearance="Secondary" Click="BtnPriceOverride_Click"/>

                <ui:Button x:Name="BtnToggleReturn" Grid.Column="5" Content="F8 - Return" Margin="6,0,0,0" 
                           Appearance="Secondary" Click="BtnToggleReturn_Click"/>
            </Grid>
        </ui:Card>

        <!-- 5. Scanned Items DataGrid -->
        <ui:DataGrid Grid.Row="5" x:Name="DataGridCart" Margin="20,0,20,0"
                     AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" FontSize="14">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding QtyDisplay}" Width="120"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding PriceExclDisplay}" Width="130"/>
                <DataGridTextColumn Header="Disc" Binding="{Binding DiscountDisplay}" Width="90"/>
                <DataGridTextColumn Header="Value (Incl)" Binding="{Binding TotalInclDisplay}" Width="140"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- 6. Totals & Checkout -->
        <ui:Card Grid.Row="6" Margin="20,10,20,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSubtotal" Text="Sub Total: R 0.00" FontSize="14" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtVat" Text="VAT (15%): R 0.00" FontSize="14" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtItemsCount" Text="Num Items: 0" FontSize="13" Foreground="Gray" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" Text="R 0.00" FontSize="36" FontWeight="Bold" 
                               Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,25,0"/>
                    <ui:Button x:Name="BtnCheckout" Content="F12 - Done (Tender)" Appearance="Primary" 
                               FontSize="16" FontWeight="SemiBold" Padding="25,12" 
                               Click="BtnCompleteSale_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 7. Bottom Shortcuts Bar -->
        <StatusBar Grid.Row="7" Margin="20,6,20,6" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="[Enter] Scan  |  [F3] Lookup  |  [F5] Disc  |  [F6] Price  |  [F8] Return  |  [F10] Reprint  |  [Ctrl+A] Acc  |  [Del] Remove  |  [F12] Done" 
                           FontSize="12" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
