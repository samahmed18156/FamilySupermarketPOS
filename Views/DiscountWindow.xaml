<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.DiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="F5 - Apply Discount - Blue_Knight POS" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Card -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="APPLY DISCOUNT" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

        <ui:Card Grid.Row="1" Padding="14">
            <StackPanel>
                <TextBlock Text="Discount Percentage (%):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="TxtPercent" Text="10" FontSize="18" TextAlignment="Right" Margin="0,0,0,10"/>

                <TextBlock Text="Fast Select %:" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <ui:Button Content="5%" Margin="0,0,3,0" Tag="5" Click="BtnFastPct_Click"/>
                    <ui:Button Content="10%" Margin="2,0,2,0" Tag="10" Click="BtnFastPct_Click"/>
                    <ui:Button Content="15%" Margin="2,0,2,0" Tag="15" Click="BtnFastPct_Click"/>
                    <ui:Button Content="20%" Margin="3,0,0,0" Tag="20" Click="BtnFastPct_Click"/>
                </UniformGrid>

                <TextBlock Text="Apply To:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <RadioButton x:Name="RadioSelected" Content="Selected Cart Item Only" IsChecked="True" Margin="0,0,0,4"/>
                <RadioButton x:Name="RadioAll" Content="Entire Cart (All Items)"/>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ui:Button Content="Cancel (Esc)" Appearance="Secondary" Height="40" Padding="18,0" Click="BtnCancel_Click"/>
            <ui:Button Content="Apply Discount (Enter)" Appearance="Primary" Height="40" Padding="20,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnApply_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
