<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.GrnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Goods Received Note (GRN) - Blue_Knight POS" Height="720" Width="1050"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Goods Received Note (GRN) - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     CanMaximize="True" />

        <Grid Margin="18" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Supplier details -->
            <RowDefinition Height="Auto"/> <!-- Item entry -->
            <RowDefinition Height="*"/>    <!-- Items grid -->
            <RowDefinition Height="Auto"/> <!-- Totals & Process button -->
        </Grid.RowDefinitions>

        <!-- 0. Header & Supplier Card -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Select Supplier / Creditor:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbSupplier" Margin="0,0,12,0" Height="36" 
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code" FontSize="14"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Supplier Invoice / Doc #:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSupplierInv" Margin="0,0,12,0" PlaceholderText="e.g. INV-98214"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="GRN Number:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtGrnNo" Text="GRN-101" IsReadOnly="True"/>
            </Grid>
        </ui:Card>

        <!-- 1. Item Entry Card -->
        <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" x:Name="TxtItemCode" PlaceholderText="Code (e.g. 1001)" Margin="0,0,8,0" KeyDown="TxtItemCode_KeyDown"/>
                <ui:TextBox Grid.Column="1" x:Name="TxtItemDescr" PlaceholderText="Description" Margin="0,0,8,0" IsReadOnly="True"/>
                <ui:TextBox Grid.Column="2" x:Name="TxtItemQty" Text="1" TextAlignment="Center" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="3" x:Name="TxtItemCost" PlaceholderText="Cost Excl" TextAlignment="Right" Margin="0,0,8,0"/>
                <ui:Button Grid.Column="4" Content="+ Add Line" Appearance="Primary" Click="BtnAddLine_Click"/>
            </Grid>
        </ui:Card>

        <!-- 2. Received Items DataGrid -->
        <ui:DataGrid Grid.Row="2" x:Name="GridGrnItems" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="14">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Qty Received" Binding="{Binding Qty}" Width="120"/>
                <DataGridTextColumn Header="Cost Price (Excl)" Binding="{Binding PriceExcl, StringFormat=R {0:N2}}" Width="150"/>
                <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalIncl, StringFormat=R {0:N2}}" Width="150"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- 3. Totals & Process Action -->
        <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCostDisplay" Text="Total GRN Cost: R 0.00" FontSize="20" FontWeight="Bold" Foreground="#0078D4"/>
                    <TextBlock Text="Processing GRN will immediately increase stock on hand (SOH) and update cost price." 
                               FontSize="12" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0" Height="42" Padding="20,0" Click="BtnCancel_Click"/>
                    <ui:Button Content="Process GRN &amp; Update Stock" Appearance="Primary" Height="42" Padding="25,0" 
                               FontWeight="Bold" FontSize="15" Click="BtnProcessGrn_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>