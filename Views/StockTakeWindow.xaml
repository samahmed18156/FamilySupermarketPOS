<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.StockTakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Stock Take Process &amp; Variance Reconciliation - Blue_Knight POS" Height="720" Width="1050"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Stock Take Process &amp; Variance Reconciliation - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     CanMaximize="True" />

        <Grid Margin="18" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Grid -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="STOCK TAKE PROCESS &amp; AUDIT" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Enter physical counted quantities to compare against system SOH and post adjustments." FontSize="12" Foreground="Gray"/>
            </StackPanel>
            <ui:Button Content="Export Stock Take Count Sheet" Appearance="Secondary" HorizontalAlignment="Right" Click="BtnExport_Click"/>
        </Grid>

        <ui:DataGrid Grid.Row="1" x:Name="GridStockTake" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="13">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="System SOH" Binding="{Binding SohDisplay}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cost (Excl)" Binding="{Binding CostDisplay}" Width="120" IsReadOnly="True"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Content="Close" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnClose_Click"/>
            <ui:Button Content="Finalize &amp; Post Variance Adjustments" Appearance="Primary" Height="40" Padding="25,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnPost_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>