<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.DebtorLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Customer Account Lookup - Blue_Knight POS" Height="550" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Search -->
            <RowDefinition Height="*"/>    <!-- Grid -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="10">
            <ui:TextBox x:Name="TxtSearch" 
                        PlaceholderText="Search by account number, name, or phone..." 
                        FontSize="15" Icon="{ui:SymbolIcon Symbol=Search24}"
                        TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
        </ui:Card>

        <ui:DataGrid Grid.Row="1" x:Name="GridDebtors" AutoGenerateColumns="False" 
                     CanUserAddRows="False" SelectionMode="Single" FontSize="14"
                     MouseDoubleClick="GridDebtors_MouseDoubleClick" KeyDown="GridDebtors_KeyDown">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Acc Num" Binding="{Binding AccountNumber}" Width="140"/>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Telephone" Binding="{Binding Telephone}" Width="150"/>
                <DataGridTextColumn Header="Credit Limit" Binding="{Binding DisplayLimit}" Width="130"/>
                <DataGridTextColumn Header="OS Balance" Binding="{Binding DisplayBalance}" Width="130"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="[Enter] Select Account  |  [Esc] Cancel" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel (Esc)" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <ui:Button Content="Select Account (Enter)" Appearance="Primary" Click="BtnSelect_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
