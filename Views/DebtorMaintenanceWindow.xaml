<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.DebtorMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Customer Account Maintenance - Blue_Knight POS" Height="680" Width="950"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Customer Account Maintenance - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     CanMaximize="True" />

        <Grid Margin="18" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CUSTOMER ACCOUNTS &amp; DEBTORS" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <ui:DataGrid Grid.Row="1" x:Name="GridDebtors" AutoGenerateColumns="False" CanUserAddRows="False" 
                     SelectionMode="Single" FontSize="13" SelectionChanged="GridDebtors_SelectionChanged">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Acc Number" Binding="{Binding AccountNumber}" Width="140"/>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Telephone" Binding="{Binding Telephone}" Width="150"/>
                <DataGridTextColumn Header="Credit Limit" Binding="{Binding DisplayLimit}" Width="130"/>
                <DataGridTextColumn Header="OS Balance" Binding="{Binding DisplayBalance}" Width="130"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Acc Number:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtAccNum" Margin="0,0,8,10"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Customer Name:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtName" Margin="0,0,8,10"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Telephone:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtPhone" Margin="0,0,8,10"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Credit Limit (R):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtLimit" Text="10000.00" TextAlignment="Right" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="+ New Account" Appearance="Secondary" Margin="0,0,8,0" Click="BtnNew_Click"/>
                    <ui:Button Content="Save Customer Account" Appearance="Primary" Padding="25,0" Height="36" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>