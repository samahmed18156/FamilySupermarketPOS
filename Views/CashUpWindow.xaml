<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.CashUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cash Up Reconciliation - Blue_Knight POS" Height="700" Width="820"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Cash Up Reconciliation - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     CanMaximize="True" />

        <Grid Margin="20" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Note / Coin Denominations -->
            <RowDefinition Height="Auto"/> <!-- Summary card -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="CASHIER SHIFT CASH UP &amp; RECONCILIATION" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Count physical cash in drawer to calculate shift variance." FontSize="12" Foreground="Gray"/>
            </StackPanel>
            <TextBlock x:Name="TxtShiftDate" HorizontalAlignment="Right" VerticalAlignment="Center" 
                       FontSize="13" Foreground="#888888"/>
        </Grid>

        <!-- Denominations Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bank Notes Column -->
                <ui:Card Grid.Column="0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="BANK NOTES" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" Foreground="#0078D4"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 200 Notes:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt200" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 100 Notes:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt100" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 50 Notes:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt50" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 20 Notes:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt20" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 10 Notes:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt10" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Coins Column -->
                <ui:Card Grid.Column="2" Padding="14">
                    <StackPanel>
                        <TextBlock Text="COINS &amp; FLOAT" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" Foreground="#0078D4"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 5 Coins:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt5" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 2 Coins:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt2" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="R 1 Coins:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt1" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="50c Coins:" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="Cnt050" Width="90" HorizontalAlignment="Right" Text="0" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Opening Float (R):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBox x:Name="TxtOpeningFloat" Width="90" HorizontalAlignment="Right" Text="500.00" 
                                        TextAlignment="Right" TextChanged="Denom_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- Summary Reconciliation Card -->
        <ui:Card Grid.Row="2" Margin="0,16,0,16" Padding="16" Background="#1E281E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Physical Cash Counted:" FontSize="12" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtPhysicalCash" Text="R 0.00" FontSize="22" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Opening Float:" FontSize="12" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtFloatDisplay" Text="R 500.00" FontSize="22" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Net Cash Sales:" FontSize="12" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="TxtNetSales" Text="R 0.00" FontSize="24" FontWeight="Bold" Foreground="#107C41"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <ui:Button Content="Close" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnClose_Click"/>
            <ui:Button Content="Save &amp; Print Cash Up Slip" Appearance="Primary" Height="40" Padding="25,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnPrint_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>