<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.QuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Customer Quotations - Blue_Knight POS" Height="680" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CUSTOMER QUOTATION MANAGER" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Prepare, print, and convert formal price quotations without deducting stock on hand." FontSize="12" Foreground="Gray"/>
            </StackPanel>
            <ui:Button Content="Save Current Cart as New Quote" Appearance="Primary" HorizontalAlignment="Right" Click="BtnSaveCurrentCart_Click"/>
        </Grid>

        <ui:DataGrid Grid.Row="1" x:Name="GridQuotes" AutoGenerateColumns="False" CanUserAddRows="False" 
                     SelectionMode="Single" FontSize="14">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Quote #" Binding="{Binding QuoteNumber}" Width="140"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}" Width="120"/>
                <DataGridTextColumn Header="Customer Account" Binding="{Binding CustomerAccount}" Width="160"/>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Total Amount" Binding="{Binding DisplayTotal}" Width="140"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Content="Close" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnClose_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Print Quotation Slip" Appearance="Secondary" Margin="0,0,10,0" Height="40" Padding="20,0" Click="BtnPrintQuote_Click"/>
                <ui:Button Content="Convert Quote to Active Sale" Appearance="Primary" Height="40" Padding="25,0" FontWeight="Bold" Click="BtnConvert_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
