<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="F12 - Payment &amp; Tender" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Total banner -->
            <RowDefinition Height="Auto"/> <!-- Payment method buttons -->
            <RowDefinition Height="Auto"/> <!-- Fast Cash buttons -->
            <RowDefinition Height="Auto"/> <!-- Tender input -->
            <RowDefinition Height="Auto"/> <!-- Change display -->
            <RowDefinition Height="*"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Total Due Banner -->
        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16" Background="#1A2B3C">
            <Grid>
                <TextBlock Text="TOTAL DUE:" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                <TextBlock x:Name="TxtTotalDue" Text="R 0.00" FontSize="36" FontWeight="Bold" 
                           Foreground="#00A2ED" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </ui:Card>

        <!-- 2. Payment Method Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="BtnCash" Grid.Column="0" Content="Cash (F1)" Appearance="Primary" 
                       FontSize="15" FontWeight="SemiBold" Height="45" Margin="0,0,6,0" Click="BtnMethod_Click"/>
            <ui:Button x:Name="BtnCard" Grid.Column="1" Content="Card (F2)" Appearance="Secondary" 
                       FontSize="15" FontWeight="SemiBold" Height="45" Margin="3,0,3,0" Click="BtnMethod_Click"/>
            <ui:Button x:Name="BtnAccount" Grid.Column="2" Content="Account (F4)" Appearance="Secondary" 
                       FontSize="15" FontWeight="SemiBold" Height="45" Margin="6,0,0,0" Click="BtnMethod_Click"/>
        </Grid>

        <!-- 3. Fast Cash Buttons -->
        <StackPanel x:Name="PanelFastCash" Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Fast Tender Amounts:" FontSize="12" Foreground="Gray" Margin="0,0,0,6"/>
            <UniformGrid Columns="5" Rows="1">
                <ui:Button x:Name="BtnExact" Content="Exact" Height="40" Margin="0,0,4,0" Click="BtnFastCash_Click"/>
                <ui:Button Content="R 50" Height="40" Margin="2,0,2,0" Tag="50" Click="BtnFastCash_Click"/>
                <ui:Button Content="R 100" Height="40" Margin="2,0,2,0" Tag="100" Click="BtnFastCash_Click"/>
                <ui:Button Content="R 200" Height="40" Margin="2,0,2,0" Tag="200" Click="BtnFastCash_Click"/>
                <ui:Button Content="R 500" Height="40" Margin="4,0,0,0" Tag="500" Click="BtnFastCash_Click"/>
            </UniformGrid>
        </StackPanel>

        <!-- 4. Amount Tendered Input -->
        <ui:Card Grid.Row="3" Margin="0,0,0,16" Padding="14">
            <Grid>
                <TextBlock Text="Cash Tendered (R):" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ui:TextBox x:Name="TxtTendered" Width="200" HorizontalAlignment="Right" 
                            FontSize="22" FontWeight="Bold" TextAlignment="Right"
                            TextChanged="TxtTendered_TextChanged" KeyDown="TxtTendered_KeyDown"/>
            </Grid>
        </ui:Card>

        <!-- 5. Change Display -->
        <ui:Card Grid.Row="4" Margin="0,0,0,16" Padding="16" Background="#1E281E">
            <Grid>
                <TextBlock Text="CHANGE:" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                <TextBlock x:Name="TxtChange" Text="R 0.00" FontSize="36" FontWeight="Bold" 
                           Foreground="#107C41" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </ui:Card>

        <!-- 6. Action Buttons -->
        <Grid Grid.Row="6">
            <TextBlock Text="[Enter] Finish  |  [Esc] Back" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel (Esc)" Appearance="Secondary" Margin="0,0,10,0" 
                           Height="45" Padding="20,0" Click="BtnCancel_Click"/>
                <ui:Button x:Name="BtnComplete" Content="Finish &amp; Print Receipt (Enter)" Appearance="Primary" 
                           Height="45" Padding="25,0" FontWeight="Bold" FontSize="15" Click="BtnComplete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
