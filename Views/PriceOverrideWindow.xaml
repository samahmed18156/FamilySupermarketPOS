<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.PriceOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="F6 - Price Override - Blue_Knight POS" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="F6 - Price Override - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Grid Margin="20" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="UNIT PRICE OVERRIDE" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

        <ui:Card Grid.Row="1" Padding="14">
            <StackPanel>
                <TextBlock x:Name="TxtItemDescr" Text="Item: Full Cream Milk 2L" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#0078D4"/>
                <TextBlock x:Name="TxtCurrentPrice" Text="Current Price: R 32.99" FontSize="12" Foreground="Gray" Margin="0,0,0,12"/>

                <TextBlock Text="New Unit Price (Incl VAT):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtNewPrice" FontSize="20" FontWeight="Bold" TextAlignment="Right"/>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ui:Button Content="Cancel (Esc)" Appearance="Secondary" Height="40" Padding="18,0" Click="BtnCancel_Click"/>
            <ui:Button Content="Update Price (Enter)" Appearance="Primary" Height="40" Padding="20,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnUpdate_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>