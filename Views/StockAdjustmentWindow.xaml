<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Stock Adjustment (Debit / Credit) - Blue_Knight POS" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Stock Adjustment (Debit / Credit) - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Grid Margin="20" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Stock Adjustment (Debits &amp; Credits)" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Adjust inventory count for damages, expiration, shrinkage, or corrections." FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code / Barcode:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtItemCode" Margin="0,0,0,10" PlaceholderText="Enter code (e.g. 1001) and press Enter" KeyDown="TxtItemCode_KeyDown"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Description &amp; SOH:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDescrAndSoh" Margin="0,0,0,10" IsReadOnly="True" PlaceholderText="Item details will show here"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Adjustment Qty:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAdjustmentQty" Margin="0,0,0,10" PlaceholderText="e.g. -2 for damage, or +10 for found stock"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Reason / Type:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbReason" Margin="0,0,0,10" Height="36" FontSize="14">
                    <ComboBoxItem Content="Damaged / Spoilage" IsSelected="True"/>
                    <ComboBoxItem Content="Expired Goods"/>
                    <ComboBoxItem Content="Inventory Count Correction"/>
                    <ComboBoxItem Content="Shrinkage / Theft"/>
                    <ComboBoxItem Content="Store Internal Use"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes / Auth:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtNotes" PlaceholderText="Optional notes or authorization manager"/>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnCancel_Click"/>
            <ui:Button Content="Apply Stock Adjustment" Appearance="Primary" Height="40" Padding="25,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnApply_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>