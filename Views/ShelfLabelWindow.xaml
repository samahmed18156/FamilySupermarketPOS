<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.ShelfLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Shelf Talker &amp; Barcode Label Generator - Blue_Knight POS" Height="650" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Shelf Talker &amp; Barcode Label Generator - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Grid Margin="20" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Item Selector -->
            <RowDefinition Height="*"/>    <!-- Visual Shelf Label Preview -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="PRINT SHELF TALKERS &amp; BARCODE LABELS" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Print aisle shelf tags with large price, barcode, and description for retail display." FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Item Selector Card -->
        <ui:Card Grid.Row="1" Margin="0,0,0,14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" x:Name="TxtSearch" PlaceholderText="Search item code or barcode (e.g. 1001, 1003)..." 
                            Margin="0,0,10,0" KeyDown="TxtSearch_KeyDown"/>

                <ComboBox Grid.Column="1" x:Name="CmbLabelSize" Margin="0,0,10,0" Height="36" FontSize="13">
                    <ComboBoxItem Content="Shelf Talker (100x50mm)" IsSelected="True"/>
                    <ComboBoxItem Content="Barcode Tag (40x30mm)"/>
                </ComboBox>

                <ui:Button Grid.Column="2" Content="Find" Appearance="Primary" Click="BtnFind_Click"/>
            </Grid>
        </ui:Card>

        <!-- Visual Label Preview Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="4" Padding="20" Margin="40,10,40,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="BLUE_KNIGHT SUPERMARKET" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Grid.Row="1" x:Name="LblItemDescr" Text="FULL CREAM MILK 2L" FontSize="22" FontWeight="Bold" Foreground="#000000" Margin="0,6,0,0"/>

                <Viewbox Grid.Row="2" Margin="0,10,0,10">
                    <TextBlock x:Name="LblPrice" Text="R 32.99" FontSize="54" FontWeight="Black" Foreground="#D83B01"/>
                </Viewbox>

                <Grid Grid.Row="3">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblCode" Text="CODE: 1001" FontSize="11" Foreground="#444444"/>
                        <TextBlock x:Name="LblBarcode" Text="BARCODE: 6001001001001" FontSize="11" Foreground="#444444"/>
                    </StackPanel>
                    <TextBlock Text="INCL 15% VAT" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#222222"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <ui:Button Content="Close" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnClose_Click"/>
            <ui:Button Content="Print Shelf Label (Zebra / Thermal)" Appearance="Primary" Height="40" Padding="25,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnPrint_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>