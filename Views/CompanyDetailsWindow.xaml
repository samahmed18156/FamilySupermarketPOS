<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.CompanyDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Company &amp; Store Details - Blue_Knight POS" Height="620" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="STORE &amp; COMPANY DETAILS" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Company / Store Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Street Address:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAddress" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="City &amp; Postal Code:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCity" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Telephone:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtPhone" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="VAT Registration #:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtVat" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Receipt Footer Note:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtFooter" Margin="0,0,0,10"/>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ui:Button Content="Cancel" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnCancel_Click"/>
            <ui:Button Content="Save Company Details" Appearance="Primary" Height="40" Padding="25,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
