<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Retail Reports &amp; Analytics - Blue_Knight POS" Height="740" Width="1100"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Report Switcher -->
            <RowDefinition Height="*"/>    <!-- Report View Grid -->
            <RowDefinition Height="Auto"/> <!-- Summary / Print footer -->
        </Grid.RowDefinitions>

        <!-- Top Switcher -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnZeroSoh" Content="Zero SOH (Re-Order)" Appearance="Primary" Margin="0,0,8,0" Click="BtnReport_Click"/>
                <ui:Button x:Name="BtnValuation" Content="Stock Valuation" Appearance="Secondary" Margin="0,0,8,0" Click="BtnReport_Click"/>
                <ui:Button x:Name="BtnDaily" Content="Daily Sales Totals" Appearance="Secondary" Click="BtnReport_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtReportTitle" Text="REPORT: ZERO STOCK ON HAND (SOH = 0)" HorizontalAlignment="Right" 
                       VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
        </Grid>

        <!-- Main Report DataGrid -->
        <ui:DataGrid Grid.Row="1" x:Name="GridReport" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="13">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
                <DataGridTextColumn Header="SOH" Binding="{Binding SohDisplay}" Width="90"/>
                <DataGridTextColumn Header="Cost Price (Excl)" Binding="{Binding CostDisplay}" Width="140"/>
                <DataGridTextColumn Header="Selling Price (Incl)" Binding="{Binding SellingPriceDisplay}" Width="150"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- Summary & Print Footer -->
        <ui:Card Grid.Row="2" Margin="0,14,0,0" Padding="14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReportSummary" Text="Total Zero SOH Items: 0" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Based on live database query against stockt2." FontSize="12" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Close" Appearance="Secondary" Margin="0,0,10,0" Height="40" Padding="20,0" Click="BtnClose_Click"/>
                    <ui:Button Content="Print Report (Slip / PDF)" Appearance="Primary" Height="40" Padding="25,0" 
                               FontWeight="Bold" Click="BtnPrintReport_Click"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
