<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.PettyCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Petty Cash Vouchers - Blue_Knight POS" Height="650" Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- DataGrid of vouchers -->
            <RowDefinition Height="Auto"/> <!-- New Voucher Form -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PETTY CASH VOUCHERS" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Record and audit cash payments taken directly from the till drawer." FontSize="12" Foreground="Gray"/>
            </StackPanel>
            <TextBlock x:Name="TxtTotalPettyCash" Text="Total Out: R 0.00" HorizontalAlignment="Right" 
                       VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#0078D4"/>
        </Grid>

        <!-- Existing Vouchers Grid -->
        <ui:DataGrid Grid.Row="1" x:Name="GridPettyCash" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="13">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Voucher #" Binding="{Binding VoucherNo}" Width="120"/>
                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DisplayDate}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                <DataGridTextColumn Header="Description / Reason" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Amount (R)" Binding="{Binding DisplayAmount}" Width="120"/>
                <DataGridTextColumn Header="Auth By" Binding="{Binding AuthorizedBy}" Width="100"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- Form to Add Voucher -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Expense Category:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbCategory" Margin="0,0,10,0" Height="36" FontSize="13">
                    <ComboBoxItem Content="Store Supplies" IsSelected="True"/>
                    <ComboBoxItem Content="Petrol / Fuel"/>
                    <ComboBoxItem Content="Staff Tea &amp; Bread"/>
                    <ComboBoxItem Content="Casual Wages"/>
                    <ComboBoxItem Content="Repairs &amp; Maintenance"/>
                    <ComboBoxItem Content="Sundry Expenses"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Description / Reason:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDescr" Margin="0,0,10,0" PlaceholderText="What was the money spent on?"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Amount (R):" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtAmount" Margin="0,0,10,0" PlaceholderText="0.00" TextAlignment="Right"/>

                <ui:Button Grid.Row="1" Grid.Column="3" Content="Issue Voucher" Appearance="Primary" Height="36" 
                           FontWeight="Bold" Click="BtnIssue_Click"/>
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
