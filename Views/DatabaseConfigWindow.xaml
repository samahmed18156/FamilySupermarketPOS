<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.DatabaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Database Connection Settings - Blue_Knight POS" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Database Connection Settings - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Grid Margin="20" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Form fields -->
            <RowDefinition Height="Auto"/> <!-- Status -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MySQL Server Configuration" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Configure connection to your MiPOS 'store' database." FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Form fields Card -->
        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Host / IP:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHost" Margin="0,0,0,10" PlaceholderText="localhost or 127.0.0.1"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPort" Margin="0,0,0,10" Text="3306"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDatabase" Margin="0,0,0,10" Text="store"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="User ID:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtUser" Margin="0,0,0,10" Text="root"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="TxtPassword" Height="36" FontSize="14" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1" Padding="6"/>
            </Grid>
        </ui:Card>

        <!-- Status Message -->
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="0,12,0,12" FontSize="13" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Text="Ready." Foreground="Gray"/>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <ui:Button Content="Test Connection" Appearance="Secondary" Height="40" Padding="16,0" Click="BtnTest_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0" Height="40" Padding="16,0" Click="BtnCancel_Click"/>
                <ui:Button Content="Save &amp; Connect" Appearance="Primary" Height="40" Padding="20,0" FontWeight="Bold" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>