<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="F10 - Last Receipt Reprint - Blue_Knight POS" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="F10 - Last Receipt Reprint - Blue_Knight POS"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Grid Margin="16" Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="THERMAL RECEIPT PREVIEW" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ui:Card Padding="12" Background="#111111">
                <TextBlock x:Name="TxtSlip" FontFamily="Consolas, Lucida Console, Courier New" FontSize="13" 
                           Foreground="#FFFFFF" TextWrapping="NoWrap"/>
            </ui:Card>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Content="Close (Esc)" Appearance="Secondary" Height="38" Padding="20,0" Click="BtnClose_Click"/>
            <ui:Button Content="Print Copy (Enter)" Appearance="Primary" Height="38" Padding="20,0" 
                       HorizontalAlignment="Right" FontWeight="Bold" Click="BtnPrint_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>