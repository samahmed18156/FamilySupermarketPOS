<ui:FluentWindow x:Class="FamilySupermarketPOS.Views.StockLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="F3 - Stock Price &amp; Item Lookup" Height="600" Width="850"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Search bar -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- Search Input -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtSearch" Grid.Column="0" 
                            PlaceholderText="Type description, item code, or department to search..." 
                            FontSize="15" Icon="{ui:SymbolIcon Symbol=Search24}"
                            TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>

                <ui:Button Grid.Column="1" Content="Search" Margin="10,0,0,0" 
                           Appearance="Primary" Click="BtnSearch_Click"/>
            </Grid>
        </ui:Card>

        <!-- Products DataGrid -->
        <ui:DataGrid Grid.Row="1" x:Name="GridProducts" AutoGenerateColumns="False" 
                     CanUserAddRows="False" SelectionMode="Single" FontSize="14"
                     MouseDoubleClick="GridProducts_MouseDoubleClick" KeyDown="GridProducts_KeyDown">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Dept" Binding="{Binding Department}" Width="130"/>
                <DataGridTextColumn Header="SOH" Binding="{Binding SohDisplay}" Width="80"/>
                <DataGridTextColumn Header="Price (Incl)" Binding="{Binding SellingPriceDisplay}" Width="130"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="[Enter] Select Item  |  [Up/Down] Navigate  |  [Esc] Cancel" 
                       VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel (Esc)" Appearance="Secondary" Margin="0,0,10,0" 
                           Click="BtnCancel_Click"/>
                <ui:Button Content="Select &amp; Add to Cart (Enter)" Appearance="Primary" 
                           Click="BtnSelect_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
